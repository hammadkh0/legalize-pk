---
import fs from "node:fs";
import path from "node:path";

import Layout from "../layouts/Layout.astro";
import HomeExplorer from "../components/HomeExplorer.vue";

const root = process.cwd();
const articlesPath = path.join(root, "public/data/articles.json");
const amendmentsPath = path.join(root, "public/data/amendments.json");

if (!fs.existsSync(articlesPath) || !fs.existsSync(amendmentsPath)) {
  throw new Error(
    "Missing generated data. Run `npm run data:generate` first (outputs `public/data/*.json`)."
  );
}

const articles = JSON.parse(fs.readFileSync(articlesPath, "utf8"));
const amendments = JSON.parse(fs.readFileSync(amendmentsPath, "utf8"));
---

<Layout title="Explore articles">
  <HomeExplorer
    client:load
    baseUrl={import.meta.env.BASE_URL}
    articles={articles.articles}
    amendments={amendments.amendments}
  />
</Layout>
